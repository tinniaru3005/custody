# ---------------------------------------------------------------- FalkorDB
# Pick ONE of the three options.

# 1) Local server (docker compose up -d falkordb)
CUSTODY_FALKORDB_HOST=localhost
CUSTODY_FALKORDB_PORT=6379
# CUSTODY_FALKORDB_USERNAME=
# CUSTODY_FALKORDB_PASSWORD=

# 2) FalkorDB Cloud: copy host, port, username and password from the instance page.
#    Enable TLS if your instance requires it.
# CUSTODY_FALKORDB_HOST=r-xxxxxxxx.instance-xxxx.falkordb.cloud
# CUSTODY_FALKORDB_PORT=6379
# CUSTODY_FALKORDB_USERNAME=falkordb
# CUSTODY_FALKORDB_PASSWORD=change-me
# CUSTODY_FALKORDB_SSL=false
#    ...or as one URL (rediss:// for TLS); a URL wins over host/port:
# CUSTODY_FALKORDB_URL=redis://falkordb:change-me@r-xxxxxxxx.falkordb.cloud:6379

# 3) Embedded FalkorDB, no server (pip install falkordblite; Python 3.12+)
# CUSTODY_FALKORDB_EMBEDDED_PATH=./.data/custody.db

# ---------------------------------------------------------------- graph
# One graph per tenant -> "<prefix>:<tenant>", e.g. custody:acme
CUSTODY_GRAPH_PREFIX=custody
# Depth bound for lineage / path-to / trace views, exact-value attribution candidates and
# Warden analyses. Guard verdicts always use a complete (unbounded) search.
CUSTODY_MAX_TRACE_DEPTH=25

# ---------------------------------------------------------------- HTTP
# Serve the built UI from the API process (frontend/dist), e.g. in Docker
# CUSTODY_STATIC_DIR=frontend/dist
# Only when the UI is hosted on a different origin:
# CUSTODY_CORS_ORIGINS=https://custody-ui.example.com

# ---------------------------------------------------------------- public demo
# One read-only synthetic tenant + "Reset Demo"; /swagger, /redoc, /openapi.json off (the /docs
# site stays). Not an auth system.
# CUSTODY_PUBLIC_DEMO=true
# CUSTODY_DEMO_TENANT=acme
# CUSTODY_DEMO_RESET_MIN_INTERVAL_S=10

# ---------------------------------------------------------------- Warden
# NOTE: the variables in this section and the benchmark section below are read from the
# process environment only, NOT from .env; export them in your shell or host settings.
# Optional: the Warden plans with Claude (tool use) instead of the offline playbook.
# ANTHROPIC_API_KEY=
# CUSTODY_WARDEN_MODEL=claude-sonnet-5-5
# Primary demo:
#   auto      replay custody/demo/fixtures/llm_run.json if it is a real-model recording
#             that contains a BLOCK; otherwise the scripted simulation (no real recording ships)
#   recorded  also replay a test-double recording (labelled as not a real model)
#   scripted  always the scripted simulation
# CUSTODY_DEMO_MODE=auto
# CUSTODY_DEMO_LLM_MODEL=   # model for scripts/record_llm_run.py

# ---------------------------------------------------------------- benchmarks (bench/)
# CUSTODY_BENCH_SBERT=all-MiniLM-L6-v2        # model for --sbert
# CUSTODY_BENCH_LLM_MODEL=claude-sonnet-4-5   # LLM judge model (differs from the Warden default)

# ---------------------------------------------------------------- frontend (Vite)
# frontend/.env.local:
# VITE_API_BASE=/api           # default; the dev server proxies /api to CUSTODY_API_URL
# VITE_TENANT=acme
# CUSTODY_API_URL=http://127.0.0.1:8000   # used by `npm run dev` for the proxy
